---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SearchBar from '../components/SearchBar.astro';
import PluginCard from '../components/PluginCard.astro';
import { getCollection } from 'astro:content';

const allPlugins = await getCollection('plugins');
const categories = [...new Set(allPlugins.map(p => p.data.category))].sort();

// Stats
const totalPlugins = allPlugins.length;
const totalCategories = categories.length;
const featuredPlugins = allPlugins.filter(p => p.data.featured);
const featuredPluginsSorted = featuredPlugins.sort((a, b) => {
  // autonomous-ai-agents first
  if (a.data.name === 'autonomous-ai-agents') return -1;
  if (b.data.name === 'autonomous-ai-agents') return 1;
  // grill-each-other second
  if (a.data.name === 'grill-each-other') return -1;
  if (b.data.name === 'grill-each-other') return 1;
  return a.data.name.localeCompare(b.data.name);
});

// Group plugins by category for category showcase
const pluginsByCategory = categories.reduce((acc, cat) => {
  acc[cat] = allPlugins.filter(p => p.data.category === cat);
  return acc;
}, {} as Record<string, typeof allPlugins>);

// Category icons
const categoryIcons: Record<string, string> = {
  'ai-agency': '🧠',
  'skill-enhancers': '⚔️',
  'automation': '⚙️',
  'business-tools': '💼',
  'devops': '🚀',
  'code-analysis': '🔍',
  'debugging': '🐛',
  'ai-ml-assistance': '🤖',
  'frontend-development': '🎨',
  'security': '🔒',
  'testing': '✅',
  'documentation': '📚',
  'performance': '⚡',
  'database': '💾',
  'cloud-infrastructure': '☁️',
  'accessibility': '♿',
  'mobile': '📱',
  'productivity': '📋',
  'other': '🔧'
};
---

<Layout
  title={`Dancer Plugin Marketplace — ${totalPlugins} Plugin Packs`}
  description={`Jack Reis's Claude Code plugin marketplace. Browse ${totalPlugins} plugin packs across ${totalCategories} categories. Fleet coordination, dialectic claim discipline, SDLC engineering, and more.`}
>
  <Hero totalPlugins={totalPlugins} totalCategories={totalCategories} />

  <SearchBar />

  <!-- Featured Plugins Section -->
  {featuredPlugins.length > 0 && (
    <section class="featured-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
            </svg>
            Featured Plugin Packs
          </h2>
          <p class="section-description">
            Jack's core plugin packs for Claude Code — fleet coordination, dialectic discipline, and engineering lifecycle
          </p>
        </div>

        <div class="plugins-grid">
          {featuredPluginsSorted.map(plugin => (
            <PluginCard {...plugin.data} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- All Plugins Section -->
  <section class="all-plugins-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" d="M3 6a3 3 0 013-3h2.25a3 3 0 013 3v2.25a3 3 0 01-3 3H6a3 3 0 01-3-3V6zm9.75 0a3 3 0 013-3H18a3 3 0 013 3v2.25a3 3 0 01-3 3h-2.25a3 3 0 01-3-3V6zM3 15.75a3 3 0 013-3h2.25a3 3 0 013 3V18a3 3 0 01-3 3H6a3 3 0 01-3-3v-2.25zm9.75 0a3 3 0 013-3H18a3 3 0 013 3V18a3 3 0 01-3 3h-2.25a3 3 0 01-3-3v-2.25z" clip-rule="evenodd" />
          </svg>
          All Plugin Packs
        </h2>
        <p class="section-description">
          Browse all {totalPlugins} plugin packs across {totalCategories} categories
        </p>
      </div>

      <div class="plugins-grid">
        {allPlugins.map(plugin => (
          <PluginCard {...plugin.data} />
        ))}
      </div>
    </div>
  </section>

  <!-- Categories Overview -->
  <section class="categories-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.644 1.59a.75.75 0 01.712 0l9.75 5.25a.75.75 0 010 1.32l-9.75 5.25a.75.75 0 01-.712 0l-9.75-5.25a.75.75 0 010-1.32l9.75-5.25z" />
            <path d="M3.265 10.602l7.668 4.129a2.25 2.25 0 002.134 0l7.668-4.13 1.37.739a.75.75 0 010 1.32l-9.75 5.25a.75.75 0 01-.71 0l-9.75-5.25a.75.75 0 010-1.32l1.37-.738z" />
            <path d="M10.933 19.231l-7.668-4.13-1.37.739a.75.75 0 000 1.32l9.75 5.25c.221.12.489.12.71 0l9.75-5.25a.75.75 0 000-1.32l-1.37-.738-7.668 4.13a2.25 2.25 0 01-2.134-.001z" />
          </svg>
          Browse by Category
        </h2>
        <p class="section-description">
          Explore plugin packs organized by functionality
        </p>
      </div>

      <div class="categories-grid">
        {categories.map(category => {
          const categoryPlugins = pluginsByCategory[category];
          const displayName = category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
          const icon = categoryIcons[category] || '🔧';

          return (
            <div class="category-card" data-category={category}>
              <div class="category-header">
                <span class="category-icon">{icon}</span>
                <h3 class="category-name">{displayName}</h3>
              </div>
              <div class="category-count">{categoryPlugins.length} packs</div>
              <div class="category-preview">
                {categoryPlugins.slice(0, 3).map(p => (
                  <div class="preview-plugin">{p.data.name}</div>
                ))}
                {categoryPlugins.length > 3 && (
                  <div class="preview-more">+{categoryPlugins.length - 3} more</div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Getting Started Section -->
  <section class="getting-started-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" d="M2.25 6a3 3 0 013-3h13.5a3 3 0 013 3v12a3 3 0 01-3 3H5.25a3 3 0 01-3-3V6zm3.97.97a.75.75 0 011.06 0l2.25 2.25a.75.75 0 010 1.06l-2.25 2.25a.75.75 0 01-1.06-1.06l1.72-1.72-1.72-1.72a.75.75 0 010-1.06zm4.28 4.28a.75.75 0 000 1.5h5.25a.75.75 0 000-1.5H10.5z" clip-rule="evenodd" />
          </svg>
          Getting Started
        </h2>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3>Add Marketplace</h3>
          <p>Connect to the Dancer plugin marketplace</p>
          <pre><code>/plugin marketplace add JackReis/dancer</code></pre>
        </div>

        <div class="step-card">
          <div class="step-number">2</div>
          <h3>Browse Packs</h3>
          <p>Explore the 5 plugin packs and 27 skills</p>
          <pre><code>/plugin list</code></pre>
        </div>

        <div class="step-card">
          <div class="step-number">3</div>
          <h3>Install & Use</h3>
          <p>Install any plugin pack with a single command</p>
          <pre><code>/plugin install plugin-name@dancer</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Resources Section -->
  <section class="resources-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.25 4.533A9.707 9.707 0 006 3a9.735 9.735 0 00-3.25.555.75.75 0 00-.5.707v14.25a.75.75 0 001 .707A8.237 8.237 0 016 18.75c1.995 0 3.823.707 5.25 1.886V4.533zM12.75 20.636A8.214 8.214 0 0118 18.75c.966 0 1.89.166 2.75.47a.75.75 0 001-.708V4.262a.75.75 0 00-.5-.707A9.735 9.735 0 0018 3a9.707 9.707 0 00-5.25 1.533v16.103z" />
          </svg>
          Resources
        </h2>
      </div>

      <div class="resources-grid">
        <a href="https://github.com/JackReis/dancer" class="resource-card" target="_blank" rel="noopener noreferrer">
          <div class="resource-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <h3>GitHub Repository</h3>
          <p>View source code, contribute, and report issues</p>
        </a>

        <a href="https://docs.claude.com/en/docs/claude-code/plugins" class="resource-card" target="_blank" rel="noopener noreferrer">
          <div class="resource-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm11.378-3.917c-.89-.777-2.366-.777-3.255 0a.75.75 0 01-.988-1.129c1.454-1.272 3.776-1.272 5.23 0 1.513 1.324 1.513 3.518 0 4.842a3.75 3.75 0 01-.837.552c-.676.328-1.028.774-1.028 1.152v.75a.75.75 0 01-1.5 0v-.75c0-1.279 1.06-2.107 1.875-2.502.182-.088.351-.199.503-.331.83-.727.83-1.857 0-2.584zM12 18a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3>Official Documentation</h3>
          <p>Learn how to create and use Claude Code plugins</p>
        </a>

        <a href="https://github.com/JackReis/dancer" class="resource-card" target="_blank" rel="noopener noreferrer">
          <div class="resource-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm-2.625 6c-.54 0-.828.419-.936.634a1.96 1.96 0 00-.189.866c0 .298.059.605.189.866.108.215.395.634.936.634.54 0 .828-.419.936-.634.13-.26.189-.568.189-.866 0-.298-.059-.605-.189-.866-.108-.215-.395-.634-.936-.634zm4.314.634c.108-.215.395-.634.936-.634.54 0 .828.419.936.634.13.26.189.568.189.866 0 .298-.059.605-.189.866-.108-.215-.395-.634-.936-.634-.54 0-.828-.419-.936-.634a1.96 1.96 0 01-.189-.866c0-.298.059-.605.189-.866zm2.023 6.828a.75.75 0 10-1.06-1.06 3.75 3.75 0 01-5.304 0 .75.75 0 00-1.06 1.06 5.25 5.25 0 007.424 0z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3>Jack Reis</h3>
          <p>Plugin author — fleet coordination, dialectic discipline, and SDLC engineering</p>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Section Styling */
  section {
    padding: 4rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 900;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .section-title svg {
    width: 2rem;
    height: 2rem;
    color: var(--green-400);
  }

  .section-description {
    font-size: 1.125rem;
    color: var(--slate-400);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Plugins Grid */
  .plugins-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .plugins-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Featured Section */
  .featured-section {
    background: linear-gradient(180deg, transparent 0%, rgba(16, 185, 129, 0.05) 50%, transparent 100%);
    border-top: 1px solid var(--slate-800);
    border-bottom: 1px solid var(--slate-800);
  }

  /* Categories Grid */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .category-card {
    background: var(--slate-850);
    border: 1px solid var(--slate-800);
    border-radius: 1rem;
    padding: 1.5rem;
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .category-card:hover {
    border-color: var(--green-500);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .category-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .category-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--slate-100);
    margin: 0;
  }

  .category-count {
    font-size: 0.875rem;
    color: var(--green-400);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .category-preview {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .preview-plugin {
    font-size: 0.875rem;
    color: var(--slate-400);
    font-family: var(--font-mono);
  }

  .preview-more {
    font-size: 0.75rem;
    color: var(--slate-600);
    font-style: italic;
  }

  /* Getting Started */
  .getting-started-section {
    background: linear-gradient(180deg, transparent 0%, rgba(16, 185, 129, 0.05) 50%, transparent 100%);
    border-top: 1px solid var(--slate-800);
    border-bottom: 1px solid var(--slate-800);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .step-card {
    background: var(--slate-850);
    border: 1px solid var(--slate-800);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    transition: all var(--transition-base);
  }

  .step-card:hover {
    border-color: var(--green-500);
    transform: translateY(-2px);
  }

  .step-number {
    width: 3rem;
    height: 3rem;
    background: linear-gradient(135deg, var(--green-500), var(--blue-500));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--slate-950);
    margin: 0 auto 1rem;
  }

  .step-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--slate-100);
    margin: 0 0 0.5rem;
  }

  .step-card p {
    color: var(--slate-400);
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .step-card pre {
    background: var(--slate-900);
    border: 1px solid var(--slate-800);
    border-radius: 0.5rem;
    padding: 0.75rem;
    margin: 0;
    overflow-x: auto;
  }

  .step-card code {
    color: var(--green-400);
    font-size: 0.875rem;
    font-family: var(--font-mono);
  }

  /* Resources */
  .resources-section {
    padding-bottom: 6rem;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .resource-card {
    background: var(--slate-850);
    border: 1px solid var(--slate-800);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    transition: all var(--transition-base);
    text-decoration: none;
    display: block;
  }

  .resource-card:hover {
    border-color: var(--green-500);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .resource-icon {
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1rem;
    color: var(--green-400);
  }

  .resource-icon svg {
    width: 100%;
    height: 100%;
  }

  .resource-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--slate-100);
    margin: 0 0 0.5rem;
  }

  .resource-card p {
    color: var(--slate-400);
    font-size: 0.875rem;
    margin: 0;
  }
</style>
