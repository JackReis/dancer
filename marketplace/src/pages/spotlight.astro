---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contributor Spotlight: Jack Reis" description="Jack Reis — creator of the Dancer plugin marketplace for Claude Code.">
  <section class="spotlight-hero">
    <div class="container">
      <div class="meta">
        <span class="kicker">Contributor Spotlight</span>
        <h1>Jack Reis</h1>
        <p>
          Creator of the <strong>Dancer</strong> plugin marketplace — 5 plugin packs, 27 skills.
          Fleet coordination, dialectic claim discipline, and SDLC engineering for Claude Code.
        </p>
        <div class="actions">
          <a class="btn" href="https://github.com/JackReis/dancer" target="_blank" rel="noopener noreferrer">Dancer Repository</a>
        </div>
      </div>
    </div>
  </section>

  <section class="details">
    <div class="container">
      <h2>Why it matters</h2>
      <p>
        Dancer brings production-grade agent coordination to Claude Code. From fleet identity
        and messaging bridges to scholastic peer-grill verification and N-agent ratification,
        these are tools built from real multi-agent operational experience.
      </p>

      <h3>Install</h3>
      <pre><code>/plugin marketplace add JackReis/dancer</code></pre>

      <h3>Learn more</h3>
      <ul>
        <li><a href="https://github.com/JackReis/dancer" target="_blank" rel="noopener noreferrer">Dancer Repository</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .spotlight-hero { padding: 1.25rem 0 0.5rem; }
  .banner { width: 100%; border: 1px solid var(--slate-800); border-radius: 0.75rem; }
  .meta { margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .kicker { color: var(--green-400); text-transform: uppercase; font-weight: 700; font-size: .85rem; letter-spacing: .04em; }
  h1 { margin: 0; }
  .actions { display: flex; gap: .75rem; margin-top: .25rem; }
  .btn { display: inline-flex; padding: .55rem .9rem; border-radius: .5rem; background: var(--green-600); color: var(--slate-50); border: 1px solid var(--green-500); font-weight: 600; }
  .btn.secondary { background: transparent; border-color: var(--slate-700); color: var(--slate-100); }
  .details { padding: 1rem 0 2rem; }
  pre { background: var(--slate-900); border: 1px solid var(--slate-800); border-radius: .5rem; padding: .75rem; overflow-x: auto; }
</style>
